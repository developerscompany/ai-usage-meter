{
  "name": "ai-usage-meter",
  "version": "4.0.1",
  "private": true,
  "description": "AI Usage Meter: Stream Deck keys for the plan limits, credits, tokens, costs and status of Claude, Codex and Kimi Code",
  "license": "MIT",
  "author": "Rivo Agency",
  "homepage": "https://github.com/developerscompany/ai-usage-meter#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/developerscompany/ai-usage-meter.git"
  },
  "bugs": {
    "url": "https://github.com/developerscompany/ai-usage-meter/issues"
  },
  "keywords": [
    "stream-deck",
    "elgato",
    "ai",
    "claude",
    "claude-code",
    "anthropic",
    "codex",
    "openai",
    "kimi",
    "usage",
    "limits"
  ],
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.js",
    "icons": "node scripts/make-icons.mjs",
    "pack": "npm run build && streamdeck validate agency.rivo.ai-usage-meter.sdPlugin && streamdeck pack agency.rivo.ai-usage-meter.sdPlugin --output dist --force",
    "marketplace": "node scripts/marketplace.mjs",
    "site": "node scripts/site.mjs"
  },
  "dependencies": {
    "@elgato/streamdeck": "3.0.3"
  },
  "devDependencies": {
    "@elgato/cli": "1.10.3",
    "esbuild": "0.25.10",
    "ws": "8.22.0"
  }
}
